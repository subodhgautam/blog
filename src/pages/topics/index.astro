---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicCard from '../../components/TopicCard.astro';
import Icon from '../../components/Icon.astro';
import { getAllTopics } from '../../lib/topics';
import { getPublishedPosts, postTopic } from '../../lib/posts';
import { getPublishedGuides, guideTopic } from '../../lib/guides';
import { href } from '../../lib/url';

const posts = await getPublishedPosts();
const guides = await getPublishedGuides();
const topics = await getAllTopics();

const noteCounts = Object.fromEntries(
  topics.map((topic) => [
    topic.slug,
    posts.filter((post) => postTopic(post).slug === topic.slug).length,
  ]),
);

const guideCounts = Object.fromEntries(
  topics.map((topic) => [
    topic.slug,
    guides.filter((guide) => guideTopic(guide).slug === topic.slug).length,
  ]),
);
---

<BaseLayout
  title="Topics"
  description="Guided courses and field notes on networking, scripting, Linux, and security."
>
  <div class="shell">
    <header class="page-head">
      <span class="eyebrow"><span class="dot"></span> The library</span>
      <h1>Topics</h1>
      <p class="page-lede">
        Pick a layer. Each topic holds its guides and the notes that go with
        them.
      </p>
    </header>

    <div class="topic-grid">
      {topics.map((topic) => (
        <TopicCard
          topic={topic}
          notes={noteCounts[topic.slug] ?? 0}
          guides={guideCounts[topic.slug] ?? 0}
        />
      ))}
    </div>

    <div class="topic-browse-actions">
      <a class="section-link" href={href('/guides/')}>
        Browse all guides <Icon name="arrow-right" size={16} />
      </a>
      <a class="section-link" href={href('/topics/notes/')}>
        Browse all notes <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </div>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TopicCard from '../../components/TopicCard.astro';
import { TOPICS } from '../../lib/site';
import { getPublishedPosts, postTopic } from '../../lib/posts';

const posts = await getPublishedPosts();
const counts = Object.fromEntries(
  Object.keys(TOPICS).map((slug) => [
    slug,
    posts.filter((post) => postTopic(post).slug === slug).length,
  ]),
);
---

<BaseLayout
  title="Topics"
  description="Browse field notes by topic: networking, scripting, Linux, and security."
>
  <div class="shell">
    <header class="page-head">
      <span class="eyebrow"><span class="dot"></span> The library</span>
      <h1>Topics</h1>
      <p class="page-lede">
        Notes are filed by the layer of the stack they live in. Pick a topic to
        see everything in that area.
      </p>
    </header>

    <div class="topic-grid" style="margin-bottom:48px">
      {Object.values(TOPICS).map((topic) => (
        <TopicCard topic={topic} count={counts[topic.slug] ?? 0} />
      ))}
    </div>
  </div>
</BaseLayout>

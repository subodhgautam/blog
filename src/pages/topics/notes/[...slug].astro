---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import PostCard from '../../../components/PostCard.astro';
import { SITE, formatDate } from '../../../lib/site';
import { href } from '../../../lib/url';
import {
  getPublishedPosts,
  postId,
  postPath,
  postReadTime,
  postTopic,
  relatedPosts,
} from '../../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({
    params: { slug: postId(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const topic = postTopic(post);
const posts = await getPublishedPosts();
const index = posts.findIndex((entry) => entry.id === post.id);
const newer = index > 0 ? posts[index - 1] : undefined;
const older = index >= 0 && index < posts.length - 1 ? posts[index + 1] : undefined;
const related = relatedPosts(posts, post, 3);

const toc = headings
  .filter((heading) => heading.depth === 2 || heading.depth === 3)
  .slice(0, 14);

const initials = SITE.author
  .split(' ')
  .map((part) => part[0])
  .join('')
  .slice(0, 2)
  .toUpperCase();
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <div class="reading-progress" data-progress aria-hidden="true"></div>

  <div class="shell article">
    <div class="article-layout" style={`--accent: ${topic.accent};`}>
      <article>
        <header class="article-header">
          <nav class="breadcrumb" aria-label="Breadcrumb">
            <a href={href('/')}>Home</a>
            <span class="sep">/</span>
            <a href={href('/topics/')}>Topics</a>
            <span class="sep">/</span>
            <a href={href('/topics/notes/')}>Notes</a>
            <span class="sep">/</span>
            <a href={href(`/topics/${topic.slug}/`)}>{topic.label}</a>
          </nav>

          <a class="topic-badge" href={href(`/topics/${topic.slug}/`)}>
            <Icon name={topic.icon} size={16} />
            {topic.label}
          </a>

          <h1 class="article-title">{post.data.title}</h1>
          <p class="article-lede">{post.data.description}</p>

          <div class="article-meta">
            <span class="author">
              <span class="avatar">{initials}</span>
              {SITE.author}
            </span>
            <span class="meta-item">
              <Icon name="clock" size={14} />
              {postReadTime(post)}
            </span>
            <time class="meta-item" datetime={post.data.pubDate.toISOString()}>
              {formatDate(post.data.pubDate)}
            </time>
            {post.data.updatedDate && (
              <span class="meta-item">
                Updated {formatDate(post.data.updatedDate)}
              </span>
            )}
          </div>
        </header>

        <div class="article-body prose">
          <Content />
        </div>

        <footer class="article-footer">
          {post.data.tags.length > 0 && (
            <div class="article-tags">
              <span class="label">Filed under</span>
              {post.data.tags.map((tag) => <span class="tag">#{tag}</span>)}
            </div>
          )}

          <nav class="pager" aria-label="Post navigation">
            {older ? (
              <a class="pager-link" href={href(postPath(older))}>
                <span class="pager-label"><Icon name="arrow-left" size={13} /> Previous note</span>
                <span class="pager-title">{older.data.title}</span>
              </a>
            ) : (
              <span></span>
            )}
            {newer ? (
              <a class="pager-link next" href={href(postPath(newer))}>
                <span class="pager-label">Next note <Icon name="arrow-right" size={13} /></span>
                <span class="pager-title">{newer.data.title}</span>
              </a>
            ) : (
              <span></span>
            )}
          </nav>
        </footer>
      </article>

      {toc.length > 1 && (
        <aside class="article-aside">
          <nav class="toc" aria-label="On this page">
            <p class="toc-title"><Icon name="book" size={14} /> On this page</p>
            <ul>
              {toc.map((heading) => (
                <li class:list={[heading.depth === 3 ? 'toc-sub' : '']}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          </nav>
        </aside>
      )}
    </div>
  </div>

  {related.length > 0 && (
    <section class="section">
      <div class="shell related">
        <div class="section-head">
          <div>
            <p class="section-kicker">Keep reading</p>
            <h2 class="section-title">Related notes</h2>
          </div>
          <a class="section-link" href={href(`/topics/${topic.slug}/`)}>
            More {topic.label.toLowerCase()} <Icon name="arrow-right" size={16} />
          </a>
        </div>
        <div class="post-grid">
          {related.map((item) => <PostCard post={item} />)}
        </div>
      </div>
    </section>
  )}
</BaseLayout>

<script>
  const bar = document.querySelector<HTMLElement>('[data-progress]');
  const body = document.querySelector<HTMLElement>('.article-body');

  if (bar && body) {
    let ticking = false;

    const update = () => {
      const rect = body.getBoundingClientRect();
      const available = rect.height - window.innerHeight * 0.5;
      const progress = available > 0 ? -rect.top / available : 0;
      bar.style.transform = `scaleX(${Math.min(1, Math.max(0, progress))})`;
      ticking = false;
    };

    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(update);
    };

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  }

  document.querySelectorAll<HTMLElement>('.toc a').forEach((link) => {
    link.addEventListener('click', (event) => {
      const target = document.querySelector<HTMLElement>(link.getAttribute('href') ?? '');
      if (!target) return;
      event.preventDefault();
      target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      history.replaceState(null, '', link.getAttribute('href'));
    });
  });
</script>

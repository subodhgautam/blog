---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import PostRow from '../../components/PostRow.astro';
import { getTopic, TOPICS } from '../../lib/site';
import { getPublishedPosts, getPostsByTopic, postTopic } from '../../lib/posts';
import { href } from '../../lib/url';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const slugs = new Set([...Object.keys(TOPICS), ...posts.map(postTopic).map((topic) => topic.slug)]);

  return [...slugs].map((topic) => ({ params: { topic } }));
}

const slug = Astro.params.topic ?? '';
const topic = getTopic(slug);
const posts = await getPostsByTopic(slug);
---

<BaseLayout
  title={`${topic.label} notes`}
  description={topic.description}
>
  <div class="shell">
    <header class="topic-hero" style={`--accent: ${topic.accent};`}>
      <a class="topic-badge" href={href('/topics/')} style={`--accent: ${topic.accent};`}>
        <Icon name="book" size={15} />
        Topics
      </a>
      <span class="topic-icon" style={`--accent: ${topic.accent}; margin-top:18px;`}>
        <Icon name={topic.icon} size={27} />
      </span>
      <h1>{topic.label}</h1>
      <p>{topic.description}</p>
      <div class="topic-stats">
        <span>{posts.length} {posts.length === 1 ? 'note' : 'notes'}</span>
        <span>Updated regularly</span>
      </div>
    </header>

    <div class="post-list">
      {posts.map((post) => <PostRow post={post} />)}
    </div>

    {posts.length === 0 && (
      <div class="empty-state">
        Nothing here yet. Add a Markdown file under <code>src/content/{slug}/</code>.
      </div>
    )}

    <div class="section" style="padding-top:10px">
      <p class="section-kicker" style="margin-bottom:12px">Other topics</p>
      <div class="tag-row">
        {Object.values(TOPICS)
          .filter((item) => item.slug !== slug)
          .map((item) => (
            <a class="btn" href={href(`/topics/${item.slug}/`)} style={`--accent: ${item.accent};`}>
              <Icon name={item.icon} size={16} />
              {item.label}
            </a>
          ))}
      </div>
    </div>
  </div>
</BaseLayout>

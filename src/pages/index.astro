---
import BaseLayout from '../layouts/BaseLayout.astro';
import Search from '../components/Search.astro';
import TopicCard from '../components/TopicCard.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { getAllTopics } from '../lib/topics';
import { getPublishedPosts, postTopic } from '../lib/posts';
import { getPublishedGuides, guideTopic } from '../lib/guides';
import { href } from '../lib/url';

const posts = await getPublishedPosts();
const guides = await getPublishedGuides();
const topics = await getAllTopics();

const noteCounts = Object.fromEntries(
  topics.map((topic) => [
    topic.slug,
    posts.filter((post) => postTopic(post).slug === topic.slug).length,
  ]),
);

const guideCounts = Object.fromEntries(
  topics.map((topic) => [
    topic.slug,
    guides.filter((guide) => guideTopic(guide).slug === topic.slug).length,
  ]),
);
---

<BaseLayout>
  <section class="home-search shell">
    <p class="home-kicker">Search guides and notes</p>
    <Search />
  </section>

  <section class="section shell" id="topics">
    <div class="section-head">
      <div>
        <p class="section-kicker">Browse the library</p>
        <h2 class="section-title">Pick a layer</h2>
      </div>
      <a class="section-link" href={href('/topics/')}>
        All topics <Icon name="arrow-right" size={16} />
      </a>
    </div>

    <div class="topic-grid">
      {topics.map((topic) => (
        <TopicCard
          topic={topic}
          notes={noteCounts[topic.slug] ?? 0}
          guides={guideCounts[topic.slug] ?? 0}
        />
      ))}
    </div>
  </section>

  <Newsletter />
</BaseLayout>

---
import Icon from './Icon.astro';
import Ambience from './Ambience.astro';
import { SITE } from '../lib/site';
import { href } from '../lib/url';

const base = import.meta.env.BASE_URL.replace(/\/+$/, '');
const rawPath = Astro.url.pathname;
const current = rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;

const links = [
  { label: 'Home', path: '/', match: (p: string) => p === '/' },
  { label: 'Guides', path: '/guides/', match: (p: string) => p.startsWith('/guides') },
  { label: 'Topics', path: '/topics/', match: (p: string) => p.startsWith('/topics') },
  { label: 'About', path: '/about/', match: (p: string) => p.startsWith('/about') },
];
---

<header class="site-header" data-header>
  <div class="shell header-inner">
    <a class="brand" href={href('/')} aria-label={`${SITE.name} home`}>
      <span class="brand-mark"><Icon name="layers" size={22} strokeWidth={1.9} /></span>
      <span class="brand-text">
        <span class="brand-name">{SITE.name}</span>
        <span class="brand-sub">{SITE.tagline}</span>
      </span>
    </a>

    <nav class="nav-pill" aria-label="Primary navigation">
      {links.map((link) => (
        <a
          class="nav-link"
          href={href(link.path)}
          aria-current={link.match(current) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="header-actions">
      <Ambience />
      <a class="icon-btn" href={SITE.github} target="_blank" rel="noreferrer" aria-label="GitHub profile">
        <Icon name="github" size={19} />
      </a>
      <button class="icon-btn theme-toggle" type="button" data-theme-toggle aria-label="Toggle color theme">
        <span class="icon-sun"><Icon name="sun" size={18} /></span>
        <span class="icon-moon"><Icon name="moon" size={18} /></span>
      </button>
      <button
        class="icon-btn menu-toggle"
        type="button"
        data-menu-toggle
        aria-expanded="false"
        aria-controls="mobile-nav"
        aria-label="Open menu"
      >
        <span data-menu-open><Icon name="menu" size={20} /></span>
        <span data-menu-close hidden><Icon name="close" size={20} /></span>
      </button>
    </div>
  </div>

  <div class="shell mobile-nav" id="mobile-nav" data-mobile-nav>
    <nav class="mobile-nav-links" aria-label="Mobile navigation">
      {links.map((link) => (
        <a
          href={href(link.path)}
          aria-current={link.match(current) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');

  const updateHeader = () => {
    header?.classList.toggle('is-stuck', window.scrollY > 6);
  };
  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });

  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const root = document.documentElement;

  const syncThemeLabel = () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    themeToggle?.setAttribute('aria-label', `Switch to ${next} theme`);
  };
  syncThemeLabel();

  themeToggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {
      /* storage may be unavailable */
    }
    syncThemeLabel();
  });

  const menuToggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
  const openIcon = document.querySelector<HTMLElement>('[data-menu-open]');
  const closeIcon = document.querySelector<HTMLElement>('[data-menu-close]');

  menuToggle?.addEventListener('click', () => {
    const isOpen = mobileNav?.classList.toggle('is-open') ?? false;
    menuToggle.setAttribute('aria-expanded', String(isOpen));
    menuToggle.setAttribute('aria-label', isOpen ? 'Close menu' : 'Open menu');
    if (openIcon) openIcon.hidden = isOpen;
    if (closeIcon) closeIcon.hidden = !isOpen;
  });

  mobileNav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) {
      mobileNav.classList.remove('is-open');
      menuToggle?.setAttribute('aria-expanded', 'false');
      if (openIcon) openIcon.hidden = false;
      if (closeIcon) closeIcon.hidden = true;
    }
  });
</script>

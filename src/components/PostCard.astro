---
import Icon from './Icon.astro';
import { formatDate } from '../lib/site';
import { href } from '../lib/url';
import { entryDescription, entryPublished, entryTitle } from '../lib/content';
import { postPath, postReadTime, postTopic, type Post } from '../lib/posts';

interface Props {
  post: Post;
  reveal?: number;
}

const { post, reveal } = Astro.props;
const topic = postTopic(post);
const url = href(postPath(post));
const title = entryTitle(post);
const description = entryDescription(post, 'note');
const published = entryPublished(post);
---

<article class:list={['post-card', reveal ? `reveal reveal-${reveal}` : '']} style={`--accent: ${topic.accent};`}>
  <div class="post-card-top">
    <a class="topic-badge" href={href(`/topics/${topic.slug}/`)}>
      <Icon name={topic.icon} size={16} />
      {topic.label}
    </a>
  </div>

  <h3 class="post-card-title">
    <a href={url}>{title}</a>
  </h3>

  <p class="post-card-desc">{description}</p>

  <div class="post-meta">
    <span>{postReadTime(post)}</span>
    <span class="sep">·</span>
    <span>{formatDate(published)}</span>
  </div>
</article>

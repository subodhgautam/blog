---
import Icon from './Icon.astro';
import type { Topic } from '../lib/site';
import { href } from '../lib/url';

interface Props {
  topic: Topic;
  notes: number;
  guides?: number;
}

const { topic, notes, guides = 0 } = Astro.props;
---

<a class="topic-card" href={href(`/topics/${topic.slug}/`)} style={`--accent: ${topic.accent};`}>
  <span class="topic-icon"><Icon name={topic.icon} size={23} /></span>
  <h3>{topic.label}</h3>
  <p>{topic.description}</p>
  <span class="topic-foot">
    {notes} {notes === 1 ? 'note' : 'notes'}{guides > 0 ? ` · ${guides} ${guides === 1 ? 'guide' : 'guides'}` : ''}
    <Icon name="arrow-right" size={16} />
  </span>
</a>

---
import Icon from './Icon.astro';
import { SITE } from '../lib/site';
import { href } from '../lib/url';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell footer-inner">
    <div class="footer-brand">
      <span class="brand-mark"><Icon name="layers" size={17} strokeWidth={1.9} /></span>
      <span>
        <strong>{SITE.name}</strong> · {SITE.tagline} · © {year}
      </span>
    </div>

    <nav class="footer-links" aria-label="Footer navigation">
      <a href={href('/writing/')}>Writing</a>
      <a href={href('/topics/')}>Topics</a>
      <a href={href('/about/')}>About</a>
      <a href={href('/rss.xml')}><Icon name="rss" /> RSS</a>
      <a href={SITE.github} target="_blank" rel="noreferrer"><Icon name="github" /> GitHub</a>
    </nav>
  </div>
</footer>

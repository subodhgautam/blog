---
import Icon from './Icon.astro';
import { formatDate } from '../lib/site';
import { href } from '../lib/url';
import { postPath, postReadTime, postTopic, type Post } from '../lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const topic = postTopic(post);
---

<a
  class="post-row"
  href={href(postPath(post))}
  data-post-row
  data-tags={post.data.tags.join(' ')}
  style={`--accent: ${topic.accent};`}
>
  <span class="post-row-main">
    <span class="post-row-title">{post.data.title}</span>
    <span class="post-row-meta">
      <span class="post-row-topic"><span class="dot"></span>{topic.label}</span>
      <span class="sep">·</span>
      <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate)}</time>
      <span class="sep">·</span>
      <span>{postReadTime(post)}</span>
    </span>
  </span>

  <span class="post-row-arrow"><Icon name="arrow-right" size={16} /></span>
</a>
